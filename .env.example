# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose creates the database with these)
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=codeforge

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# The API refuses to start with the dev default when ENVIRONMENT != development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_MINUTES=720
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Token buckets: "<capacity>/<seconds>" per user (submit/run) or per IP (auth)
RATE_LIMIT_SUBMIT=10/60
RATE_LIMIT_RUN=20/60
RATE_LIMIT_AUTH=10/60

# Workers
WORKER_CONCURRENCY=2
LEASE_SECONDS=90
MAX_ATTEMPTS=3
VISIBILITY_TIMEOUT_SECONDS=180

# Optional: create an "admin" user during seeding (can invalidate caches)
CODEFORGE_ADMIN_PASSWORD=

# Ports / public URL the browser uses to reach the API
API_PORT=8000
WEB_PORT=3000
PUBLIC_API_URL=http://localhost:8000
